{
  "version": "agent-simulate.cli.v1",
  "name": "cli-framework-runtime-manifest",
  "required_env": [
    "SIMULATE_CLI_FRAMEWORK_EXAMPLE_KEY"
  ],
  "scenario": {
    "name": "cli-framework-runtime-manifest",
    "dataset": [
      {
        "persona": {
          "name": "Sam",
          "role": "framework-certifier"
        },
        "situation": "Sam needs a manifest-declared LangGraph-like runtime certified before optimization.",
        "outcome": "Manifest-declared LangGraph runtime passed with trace evidence."
      }
    ]
  },
  "agent": {
    "type": "framework",
    "framework": "langgraph",
    "target": "local_manifest_framework_agent.py:build_agent",
    "factory": true,
    "method": "ainvoke",
    "input_mode": "dict",
    "trace_runtime": true,
    "metadata": {
      "suite": "cli-framework-runtime-manifest"
    },
    "runtime_metadata": {
      "contract": "runtime_adapter_v1"
    }
  },
  "simulation": {
    "engine": "local_text",
    "max_turns": 1,
    "min_turns": 1
  },
  "evaluation": {
    "agent_report": {
      "threshold": 0.85,
      "config": {
        "required_tools": [
          "lookup_policy"
        ],
        "required_framework_runtime": [
          "framework_runtime",
          "method",
          "input",
          "output",
          "tool",
          "artifact",
          "event",
          "metadata"
        ],
        "framework_runtime_contract": {
          "framework": "langgraph",
          "method": "ainvoke",
          "input_mode": "dict",
          "min_invocation_count": 1,
          "required_signals": [
            "tool",
            "artifact",
            "event",
            "metadata"
          ],
          "required_tools": [
            "lookup_policy"
          ],
          "required_artifact_types": [
            "json"
          ],
          "required_event_types": [
            "runtime_checkpoint"
          ],
          "required_metadata_keys": [
            "runtime_contract"
          ],
          "max_error_count": 0
        },
        "metric_weights": {
          "framework_runtime_coverage": 3.0,
          "framework_runtime_contract": 5.0,
          "tool_selection": 1.0
        }
      }
    }
  }
}
